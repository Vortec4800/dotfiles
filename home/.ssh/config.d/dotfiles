# SSH defaults for every host. Linked from ~/dotfiles; the first line of
# ~/.ssh/config includes ~/.ssh/config.d/*. Host aliases for your machines are
# generated next to this file (dotfiles-hosts) by `bootstrap.sh ssh`.

Host *
	# Unlock the key once with the passphrase stored in the macOS Keychain,
	# then keep it in the agent.
	AddKeysToAgent yes
	IgnoreUnknown UseKeychain
	UseKeychain yes
	IdentityFile ~/.ssh/id_ed25519
	# known_hosts.dotfiles holds GitHub's published host keys and your machines'
	# host keys from the repo, so first connections are verified too.
	UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/known_hosts.dotfiles
