# Command-line tools for every Mac. `./bootstrap.sh brew` installs this file
# together with Brewfile.apps and Brewfile.work or Brewfile.personal.
# Syncthing and sleepwatcher are left to devsync, on personal Macs only.

tap "oven-sh/bun"

# Base
brew "git"
brew "gh"
brew "jq"
brew "fnm"
brew "mas"
brew "shellcheck"

# JavaScript and Python runtimes
brew "oven-sh/bun/bun"
brew "deno"
brew "uv"
brew "pipx"

# iOS
brew "swiftformat"
brew "swiftgen"
brew "swift-outdated"
brew "xcbeautify"
brew "xcode-build-server"

# Android
brew "apktool"

# AI
brew "pi-coding-agent"
